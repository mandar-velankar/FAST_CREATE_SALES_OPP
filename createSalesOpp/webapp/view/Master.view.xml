<mvc:View
	controllerName="com.bayer.tender.createsalesopportunity.controller.Master"
	xmlns="sap.m"
	xmlns:semantic="sap.f.semantic"
	xmlns:f="sap.f"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core">

	<f:DynamicPage id="dynamicPageId" toggleHeaderOnTitleClick="false">
		<!-- DynamicPage Title -->
		<f:title>
			<f:DynamicPageTitle>
				<f:heading>
					<Title text="{masterView>/title}"/>
				</f:heading>
			</f:DynamicPageTitle>
		</f:title>

		<!-- DynamicPage Content -->
		<f:content>
			<VBox fitContainer="true">
			<OverflowToolbar class="sapFDynamicPageAlignContent">

					<!-- Filter for Country -->
					<Label text="Country:" />
					<Select id="idSlctCountry" forceSelection="true" items="{ path: 'soa>/countries', sorter: { path: 'countryName' } }"
							change=".setFilter">
							<core:Item key="{soa>countryCode}" text="{soa>countryName}"/>
					</Select>

					<!-- Filter for Status -->
					<Label text="Status:" />
					<Select id="idSlctStatusFilter" forceSelection="true" change=".setFilter">
							<core:Item key="" text=""/>
							<core:Item key="New" text="New"/>
							<core:Item key="Declined" text="Declined"/>
							<core:Item key="Active" text="Active"/>
					</Select>

					<!-- Filter for Substatus -->
					<Label text="Sub Status:" />
					 <Select id="idSlctSubStatusFilter" forceSelection="true" change=".setFilter">
							<core:Item key="" text=""/>
							<core:Item key="NA" text="NA"/>
							<core:Item key="Draft" text="Draft"/>
							<core:Item key="Quotation Submitted" text="Quotation Submitted"/>
							<core:Item key="Won" text="Won"/>
							<core:Item key="Lost" text="Lost"/>
					</Select>
					<!-- Filter for Division -->
					<Label text="Division:" />
					 <Select id="idSlctDivisionFilter" forceSelection="true" change=".setFilter">
							<core:Item key="" text=""/>
							<core:Item key="Pharma" text="Pharma"/>
							<core:Item key="Radiology" text="Radiology"/>
							<core:Item key="Both" text="Both"/>
					</Select>
					<ToolbarSpacer/>
					
					<SearchField id="idSearch" search=".setFilter" width="17.5rem"/>
					<!-- Button for adding a new tender -->
					<Button icon="sap-icon://add" text="Create New" press=".onAdd"/>
					<Button icon="sap-icon://sort" text="" press=".onOpenViewSettings"/>
				</OverflowToolbar>
				<Table
						id="list"
						inset="false"
						items="{
							path: '/PublicSalesOpportunities',
							sorter: {
								path: 'TenderReference',
								descending: false
							},
							parameters: {
								expand: 'Products,Institute'
							}
						}"
						class="sapFDynamicPageAlignContent"
						width="auto"
						updateFinished=".onUpdateFinished"
						alternateRowColors="true"
						contextualWidth="Auto" 
						popinLayout="Block"
						growing="true"
						growingThreshold="15"
						growingScrollToLoad="false">
					<columns>
						<Column width="6%" minScreenWidth="920px" demandPopin="false" popinDisplay="Inline" visible="{= ${appView>/layout} === 'OneColumn' }">
							<header>
								<ObjectIdentifier title="{i18n>countryCode}" />
							</header>
						</Column>
						<Column width="10%" visible="true">
							<header>
								<ObjectIdentifier title="{i18n>reference}" />
							</header>
						</Column>
						<Column width="19%" minScreenWidth="Desktop" demandPopin="true" popinDisplay="Inline" visible="true">
							<header>
								<ObjectIdentifier title="{i18n>clasficn}" />
							</header>
						</Column>
						<Column width="11%" minScreenWidth="Desktop" demandPopin="true" popinDisplay="Inline">
							<header>
								<ObjectIdentifier title="{i18n>division}" />
							</header>
						</Column>
						<Column width="11%" minScreenWidth="Desktop" demandPopin="true" popinDisplay="Inline">
							<header>
								<ObjectIdentifier title="{i18n>channel}" />
							</header>
						</Column>
						<Column width="7.5%" minScreenWidth="Desktop" demandPopin="true" popinDisplay="Inline">
							<header>
								<ObjectIdentifier title="Status" />
							</header>
						</Column>
						<Column width="7.5%" minScreenWidth="Desktop" demandPopin="true" popinDisplay="Inline">
							<header>
								<ObjectIdentifier title="Substatus" />
							</header>
						</Column>
						<Column width="12%"  minScreenWidth="Desktop" demandPopin="true" popinDisplay="Inline">
							<header>
								<ObjectIdentifier title="{i18n>pubcndte}" />
							</header>
						</Column>
						<Column width="12%"  minScreenWidth="Desktop" demandPopin="true" popinDisplay="Inline">
							<header>
								<ObjectIdentifier title="{i18n>offrdudte}" />
							</header>
						</Column>
						<Column width="12%"  minScreenWidth="Desktop" demandPopin="true" popinDisplay="Inline">
							<header>
								<ObjectIdentifier title="{i18n>oppValue}" />
							</header>
						</Column>
						<!-- <Column width="12%"  minScreenWidth="Desktop" demandPopin="true" popinDisplay="Inline">
							<header>
								<ObjectIdentifier title="{i18n>nwpubdate}" />
							</header>
						</Column>
						<Column width="8%" minScreenWidth="Desktop" demandPopin="true" popinDisplay="Inline">
							<header>
								<ObjectIdentifier title="{i18n>contractLength}" />
							</header>
						</Column>
						<Column width="7.5%" minScreenWidth="Desktop" demandPopin="true" popinDisplay="Inline">
							<header>
								<ObjectIdentifier title="{i18n>contractExtension}" />
							</header>
						</Column> -->
						<Column width="5%" minScreenWidth="920px" demandPopin="false" popinDisplay="Inline" visible="{= ${appView>/layout} === 'OneColumn' }">
							<header>
								<Label text=""/>
							</header>
						</Column>
					</columns>
					<items>
						<ColumnListItem type="Navigation" press=".onSelectionChange" highlight="{parts:['MainStatus','SubStatus'],formatter:'.OpportunityFormatter.statusToColor'}" id="items">
							<cells>
								<Text text="{CountryCode}"/>
								<Text text="{TenderReference}"/>
								<Text text="{Classification}"/>
								<Text text="{Division}"/>
								<Text text="{TenderChannel}"/>
								<Text text="{MainStatus}"/>
								<Text text="{SubStatus}"/>
								<Text text="{
										path: 'PublicationDate',
										type: 'sap.ui.model.type.Date',
										formatOptions: {
											pattern: 'yyyy-MM-dd'
										}
									}" 
								/>
								<Text text="{
										path: 'OfferDueDate',
										type: 'sap.ui.model.type.Date',
										formatOptions: {
											pattern: 'yyyy-MM-dd'
										}
									}" 
								/>
								<Text text="{OpportunityValue}"/>
								<!-- <Text text="{
										path: 'NextPublicationDate',
										type: 'sap.ui.model.type.Date',
										formatOptions: {
											pattern: 'yyyy-MM-dd'
										}
									}" 
								/>
								<Text text="{ContractLength}"/>
								<Text text="{ExtensionPeriod}"/> -->
								<Button text="{= ${MainStatus}==='Active'?${i18n>goToTender}:${i18n>participate}}" type="Emphasized" press="onParticipateOpportunityPress"/>
							</cells>
						</ColumnListItem>
					</items>
				</Table>
			</VBox>
		</f:content>
	</f:DynamicPage>
</mvc:View>